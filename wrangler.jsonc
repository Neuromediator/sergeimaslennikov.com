{
  // A static-assets-only Worker: no server code, just the files build.py writes.
  // Cloudflare Workers Builds runs "python3 build.py" and then "npx wrangler deploy"
  // on every push to main.
  "name": "sergeimaslennikov-com",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    // "/avatar" serves /avatar/index.html and redirects to the trailing slash
    "html_handling": "auto-trailing-slash"
  }
}
